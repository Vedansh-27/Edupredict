# Environment variable template for EduPredict Cloud
# Copy this file to .env and fill in values if needed.
# The current version of this application does not require any secrets.
# This file is provided for future extensibility.

# Application port (used when running locally; Render sets PORT automatically)
PORT=8000

# If you add a database or external service in future, add keys here:
# DATABASE_URL=
# SECRET_KEY=
# ALLOWED_ORIGINS=http://localhost:8000
